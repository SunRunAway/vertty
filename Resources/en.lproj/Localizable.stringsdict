<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>%lld agents are working. Quitting will interrupt their current tasks.</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@n@</string>
        <key>n</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>1 agent is working. Quitting will interrupt its current task.</string>
            <key>other</key>
            <string>%lld agents are working. Quitting will interrupt their current tasks.</string>
        </dict>
    </dict>
    <key>Its %lld open sessions will be closed (their history is kept and can be resumed later). No files are deleted.</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@n@</string>
        <key>n</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Its open session will be closed (its history is kept and can be resumed later). No files are deleted.</string>
            <key>other</key>
            <string>Its %lld open sessions will be closed (their history is kept and can be resumed later). No files are deleted.</string>
        </dict>
    </dict>
    <key>Close %lld other running sessions?</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@n@</string>
        <key>n</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Close the other running session?</string>
            <key>other</key>
            <string>Close %lld other running sessions?</string>
        </dict>
    </dict>
</dict>
</plist>
