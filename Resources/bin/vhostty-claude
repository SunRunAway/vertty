#!/bin/sh
# Started by Vhostty in each tab: runs Claude Code with Vhostty's extra hook
# settings (merged with your own ~/.claude settings, which stay untouched).
# A session still running in the background (←) can't be resumed; open it with
# `claude attach` instead. Its job lives in ~/.claude/jobs/<first 8 of the id>.
if [ "$1" = "--resume" ] && [ -n "$2" ]; then
  job=$(printf '%s' "$2" | cut -c1-8)
  file="$HOME/.claude/jobs/$job/state.json"
  if [ -f "$file" ] && grep -q "^  \"sessionId\": \"$2\"" "$file" &&
     ! grep -q '^  "state": "\(done\|stopped\)"' "$file"; then
    # A scheduled run brings a prompt, which attach can't take: don't run it.
    if [ -n "$VHOSTTY_SCHEDULE_RUN" ]; then
      echo "Vhostty: this session is running in the background; the scheduled run was not started." >&2
      exit 75
    fi
    exec claude attach "$job"
  fi
fi
# Vhostty's scheduled-task tools come in as an MCP server for this session only
# (the same one Codex cards get). Unlike a skill listing, an MCP server's
# instructions are sent again after the conversation is compacted.
if [ -n "$VHOSTTY_SCHEDULE_CLI" ] && [ -x "$VHOSTTY_SCHEDULE_CLI" ]; then
  mcp=$(printf '{"mcpServers":{"vhostty":{"command":"%s","args":["mcp"],"env":{"VHOSTTY_TAB_ID":"%s","VHOSTTY_SOCK":"%s"}}}}' \
    "$VHOSTTY_SCHEDULE_CLI" "$VHOSTTY_TAB_ID" "$VHOSTTY_SOCK")
  set -- --mcp-config "$mcp" "$@"
fi
if [ -n "$VHOSTTY_CLAUDE_SETTINGS" ] && [ -f "$VHOSTTY_CLAUDE_SETTINGS" ]; then
  exec claude --settings "$VHOSTTY_CLAUDE_SETTINGS" "$@"
fi
exec claude "$@"
