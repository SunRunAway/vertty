#!/bin/sh
# Started by Vhostty in each Codex tab. --no-daemon: the card runs its own app
# server instead of Codex's shared background one, so the session stays local
# (worktrees work) and ends with the card. Vhostty's scheduled-task tools come in
# as an MCP server for this session only.
sub=
if [ "$1" = "resume" ]; then
  sub=resume
  shift
fi
if [ -n "$VHOSTTY_SCHEDULE_CLI" ] && [ -x "$VHOSTTY_SCHEDULE_CLI" ]; then
  set -- \
    -c "mcp_servers.vhostty.command=\"$VHOSTTY_SCHEDULE_CLI\"" \
    -c 'mcp_servers.vhostty.args=["mcp"]' \
    -c "mcp_servers.vhostty.env.VHOSTTY_TAB_ID=\"$VHOSTTY_TAB_ID\"" \
    -c "mcp_servers.vhostty.env.VHOSTTY_SOCK=\"$VHOSTTY_SOCK\"" \
    "$@"
fi
codex $sub --no-daemon "$@"
status=$?
# Tell Vhostty it quit, through the same helper Claude Code's hooks use.
if [ -n "$VHOSTTY_HOOK" ] && [ -x "$VHOSTTY_HOOK" ]; then
  printf '{"hook_event_name":"SessionEnd"}' | "$VHOSTTY_HOOK"
fi
exit $status
