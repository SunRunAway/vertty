#!/bin/sh
# Started by Vhostty in each Codex tab. Codex's TUI talks to a shared background
# server, so Vhostty can't see from processes when it quits; tell it here, through
# the same helper Claude Code's hooks use.
# Connect to Vhostty's own app server when it's up: it carries Vhostty's
# built-in skills and the environment they need.
if [ -n "$VHOSTTY_CODEX_REMOTE" ] && [ -S "$VHOSTTY_CODEX_REMOTE" ]; then
  if [ "$1" = "resume" ]; then
    shift
    codex resume --remote "unix://$VHOSTTY_CODEX_REMOTE" "$@"
  else
    # The server runs elsewhere: tell it this card's directory.
    codex --remote "unix://$VHOSTTY_CODEX_REMOTE" -C "$PWD" "$@"
  fi
else
  codex "$@"
fi
status=$?
if [ -n "$VHOSTTY_HOOK" ] && [ -x "$VHOSTTY_HOOK" ]; then
  printf '{"hook_event_name":"SessionEnd"}' | "$VHOSTTY_HOOK"
fi
exit $status
