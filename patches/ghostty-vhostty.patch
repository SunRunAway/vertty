diff --git a/src/termio/remote.zig b/src/termio/remote.zig
new file mode 100644
index 0000000..0e3d9ab
--- /dev/null
+++ b/src/termio/remote.zig
@@ -0,0 +1,260 @@
+//! Vhostty: mirroring a terminal to a remote client.
+//!
+//! A tap gets a snapshot that rebuilds the terminal's current state, then
+//! every byte the program writes, in order. Both are delivered on the IO
+//! thread with the terminal state mutex held, so the stream continues
+//! exactly where the snapshot left off. A new snapshot follows every change
+//! of the grid size: the client resets its terminal to that size and
+//! replays it, so it never has to reflow on its own.
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const terminalpkg = @import("../terminal/main.zig");
+const formatter = terminalpkg.formatter;
+const modespkg = terminalpkg.modes;
+const Terminal = terminalpkg.Terminal;
+const Screen = terminalpkg.Screen;
+
+const log = std.log.scoped(.remote_tap);
+
+pub const Kind = enum(u32) {
+    /// Bytes the program wrote, already applied to the terminal.
+    output = 0,
+
+    /// Bytes that rebuild the whole state on a reset terminal of the
+    /// given size (they start with RIS).
+    snapshot = 1,
+};
+
+/// (userdata, kind, columns, rows, data, len)
+pub const Callback = *const fn (?*anyopaque, u32, u16, u16, [*]const u8, usize) callconv(.c) void;
+
+pub const Tap = struct {
+    userdata: ?*anyopaque,
+    callback: Callback,
+
+    /// Rows of scrollback the snapshot includes.
+    history: usize,
+
+    pub fn output(self: Tap, t: *const Terminal, buf: []const u8) void {
+        if (buf.len == 0) return;
+        self.callback(self.userdata, @intFromEnum(Kind.output), t.cols, t.rows, buf.ptr, buf.len);
+    }
+
+    pub fn snapshot(self: Tap, alloc: Allocator, t: *const Terminal) void {
+        var aw: std.Io.Writer.Allocating = .init(alloc);
+        defer aw.deinit();
+        write(&aw.writer, t, self.history) catch |err| {
+            log.warn("failed to write terminal snapshot err={}", .{err});
+            return;
+        };
+        const data = aw.written();
+        self.callback(self.userdata, @intFromEnum(Kind.snapshot), t.cols, t.rows, data.ptr, data.len);
+    }
+};
+
+const row_opts: formatter.Options = .{ .emit = .vt, .unwrap = false, .trim = true };
+
+/// Writes bytes that rebuild `t` on a terminal of the same size: the primary
+/// screen with up to `history` rows of scrollback, the alternate screen if it
+/// is active, then modes, margins, tabstops and the cursor.
+pub fn write(w: *std.Io.Writer, t: *const Terminal, history: usize) std.Io.Writer.Error!void {
+    // Start from a clean terminal.
+    try w.writeAll("\x1bc");
+
+    var tf: formatter.TerminalFormatter = .init(t, .vt);
+    tf.content = .none;
+    tf.extra = .none;
+    tf.extra.palette = true;
+    try tf.format(w);
+
+    // Content is printed with the default modes (no insert mode, autowrap
+    // on, ...), so the modes come after it.
+    const primary = t.screens.get(.primary).?;
+    try writeScreen(w, primary, history);
+    try writeScreenState(w, primary);
+
+    if (t.screens.active_key == .alternate) {
+        const enter = if (t.modes.get(.alt_screen_save_cursor_clear_enter))
+            "\x1b[?1049h"
+        else if (t.modes.get(.alt_screen_legacy))
+            "\x1b[?47h"
+        else
+            "\x1b[?1047h";
+        try w.writeAll(enter);
+        const alt = t.screens.active;
+        try writeScreen(w, alt, 0);
+        try writeScreenState(w, alt);
+    }
+
+    inline for (@typeInfo(modespkg.Mode).@"enum".fields) |field| {
+        const mode: modespkg.Mode = comptime @enumFromInt(field.value);
+        if (comptime !skipMode(mode)) {
+            const current = t.modes.get(mode);
+            const default_val = @field(t.modes.default, field.name);
+            if (current != default_val) {
+                const tag: modespkg.ModeTag = @bitCast(@intFromEnum(mode));
+                const prefix = if (tag.ansi) "" else "?";
+                const suffix = if (current) "h" else "l";
+                try w.print("\x1b[{s}{d}{s}", .{ prefix, tag.value, suffix });
+            }
+        }
+    }
+
+    tf.extra = .none;
+    tf.extra.scrolling_region = true;
+    tf.extra.tabstops = true;
+    tf.extra.keyboard = true;
+    tf.extra.pwd = true;
+    try tf.format(w);
+
+    // Margins and tabstops moved the cursor; origin mode homes it too.
+    const cursor = &t.screens.active.cursor;
+    if (t.modes.get(.origin)) {
+        const region = &t.scrolling_region;
+        try w.writeAll("\x1b[?6h");
+        try w.print("\x1b[{d};{d}H", .{
+            cursor.y -| region.top + 1,
+            cursor.x -| region.left + 1,
+        });
+    } else {
+        try w.print("\x1b[{d};{d}H", .{ cursor.y + 1, cursor.x + 1 });
+    }
+}
+
+/// Modes written separately, or that mustn't be replayed.
+fn skipMode(mode: modespkg.Mode) bool {
+    return switch (mode) {
+        .alt_screen_legacy,
+        .alt_screen,
+        .alt_screen_save_cursor_clear_enter,
+        .synchronized_output,
+        .origin,
+        => true,
+        else => false,
+    };
+}
+
+/// Prints a screen's rows: the last `history` rows of scrollback scrolled
+/// off the top, then the active area from its top-left corner. Rows are
+/// written one by one so blank rows keep their place.
+fn writeScreen(w: *std.Io.Writer, screen: *const Screen, history: usize) std.Io.Writer.Error!void {
+    const pages = &screen.pages;
+    const rows: usize = pages.rows;
+    const history_total = pages.total_rows -| rows;
+    const n = @min(history_total, history);
+    if (n > 0) {
+        var y = history_total - n;
+        while (y < history_total) : (y += 1) {
+            try writeRow(w, screen, .{ .screen = .{ .y = @intCast(y) } });
+            try w.writeAll("\r\n");
+        }
+        // The cursor is n rows down: scroll the printed rows into the
+        // scrollback, leaving a blank active area.
+        try w.splatByteAll('\n', rows - 1);
+        try w.writeAll("\x1b[H");
+    }
+    for (0..rows) |y| {
+        try writeRow(w, screen, .{ .active = .{ .y = @intCast(y) } });
+        if (y + 1 < rows) try w.writeAll("\r\n");
+    }
+}
+
+fn writeRow(w: *std.Io.Writer, screen: *const Screen, pt: terminalpkg.point.Point) std.Io.Writer.Error!void {
+    const pages = &screen.pages;
+    const start = pages.pin(pt) orelse return;
+    var end = start;
+    end.x = pages.cols - 1;
+    var f: formatter.PageListFormatter = .init(pages, row_opts);
+    f.top_left = start;
+    f.bottom_right = end;
+    try f.format(w);
+}
+
+/// Style, hyperlink, protection, keyboard flags, charsets and cursor of
+/// the screen just printed.
+fn writeScreenState(w: *std.Io.Writer, screen: *const Screen) std.Io.Writer.Error!void {
+    var sf: formatter.ScreenFormatter = .init(screen, .vt);
+    sf.content = .none;
+    sf.extra = .all;
+    try sf.format(w);
+}
+
+const testing = std.testing;
+
+/// Rebuilds `src` from its snapshot in a new terminal of the same size and
+/// checks the result: the same text, cursor and screen, and a snapshot of
+/// the copy identical to the original's.
+fn expectRoundTrip(src: *Terminal, history: usize) !void {
+    const alloc = testing.allocator;
+    var first: std.Io.Writer.Allocating = .init(alloc);
+    defer first.deinit();
+    try write(&first.writer, src, history);
+
+    var dst = try Terminal.init(alloc, .{ .cols = src.cols, .rows = src.rows });
+    defer dst.deinit(alloc);
+    var s = dst.vtStream();
+    defer s.deinit();
+    try s.nextSlice(first.written());
+
+    var second: std.Io.Writer.Allocating = .init(alloc);
+    defer second.deinit();
+    try write(&second.writer, &dst, history);
+    try testing.expectEqualStrings(first.written(), second.written());
+
+    const want = try src.screens.active.dumpStringAlloc(alloc, .{ .active = .{} });
+    defer alloc.free(want);
+    const got = try dst.screens.active.dumpStringAlloc(alloc, .{ .active = .{} });
+    defer alloc.free(got);
+    try testing.expectEqualStrings(want, got);
+    try testing.expectEqual(src.screens.active_key, dst.screens.active_key);
+    try testing.expectEqual(src.screens.active.cursor.x, dst.screens.active.cursor.x);
+    try testing.expectEqual(src.screens.active.cursor.y, dst.screens.active.cursor.y);
+}
+
+test "remote snapshot: lines, styles and blank rows" {
+    var t = try Terminal.init(testing.allocator, .{ .cols = 10, .rows = 4 });
+    defer t.deinit(testing.allocator);
+    var s = t.vtStream();
+    defer s.deinit();
+    try s.nextSlice("one\r\n\x1b[1;31mtwo\x1b[0m\r\n\r\nfour\x1b[2;3H");
+    try expectRoundTrip(&t, 100);
+}
+
+test "remote snapshot: scrollback above a cleared screen" {
+    var t = try Terminal.init(testing.allocator, .{ .cols = 10, .rows = 4 });
+    defer t.deinit(testing.allocator);
+    var s = t.vtStream();
+    defer s.deinit();
+    for (0..20) |i| {
+        var buf: [16]u8 = undefined;
+        try s.nextSlice(try std.fmt.bufPrint(&buf, "line {d}\r\n", .{i}));
+    }
+    // Scroll everything off, then write at the top of a blank screen.
+    try s.nextSlice("\r\n\r\n\r\n\x1b[Htop");
+    try expectRoundTrip(&t, 100);
+
+    const alloc = testing.allocator;
+    var out: std.Io.Writer.Allocating = .init(alloc);
+    defer out.deinit();
+    try write(&out.writer, &t, 5);
+    var dst = try Terminal.init(alloc, .{ .cols = 10, .rows = 4 });
+    defer dst.deinit(alloc);
+    var ds = dst.vtStream();
+    defer ds.deinit();
+    try ds.nextSlice(out.written());
+    // Only the last five rows of scrollback came along.
+    try testing.expectEqual(@as(usize, 5 + 4), dst.screens.active.pages.total_rows);
+    try expectRoundTrip(&t, 5);
+}
+
+test "remote snapshot: alternate screen, modes and margins" {
+    var t = try Terminal.init(testing.allocator, .{ .cols = 20, .rows = 6 });
+    defer t.deinit(testing.allocator);
+    var s = t.vtStream();
+    defer s.deinit();
+    try s.nextSlice("shell prompt $ \r\nmore");
+    try s.nextSlice("\x1b[?1049h\x1b[?2004h\x1b[?1h\x1b[?1002h\x1b[?1006h\x1b[>1u");
